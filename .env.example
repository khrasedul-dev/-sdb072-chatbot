# ====================================================================
#  SECRETS ONLY. Copy to .env and fill in. Never committed.
#
#  Everything else — admin username, channel, welcome behaviour — lives
#  in src/messages.js, so it changes with a push. Port and host come
#  from deploy/ecosystem.config.cjs.
# ====================================================================

# From https://t.me/BotFather
BOT_TOKEN=

# Userbot only. From https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Written here by `npm run userbot:login`. This string IS the account —
# anyone holding it is signed in, no password and no code.
USERBOT_SESSION=
