# ====================================================================
#  Copy this file to .env and fill in BOT_TOKEN. Everything else is
#  optional — the defaults below are what the bot uses.
# ====================================================================

# Required. From https://t.me/BotFather
BOT_TOKEN=

# Telegram username (no @) that the buttons open a chat with. This account is
# also the only one allowed to run /post.
ADMIN_USERNAME=potlood17

# Channel or group that /post publishes the VIP message to.
#   public channel -> @yourchannel
#   private channel -> -100xxxxxxxxxx
# To find a private channel's id, forward any post from it to the bot in a
# private chat and it replies with the id.
CHANNEL_ID=

# ---------------------------------------------------------------
#  Webhook — normally you do NOT set this.
#
#  On a hosting platform the bot reads the public URL the platform
#  already provides (Render, Railway, Koyeb, Fly, Vercel, Cyclic,
#  Hugging Face, Azure) and sets its own webhook on startup.
#  Set WEBHOOK_URL only to override that, e.g. a custom domain or an
#  ngrok tunnel while testing.
# ---------------------------------------------------------------
# WEBHOOK_URL=https://your-app.onrender.com

# Force long polling instead of a webhook. `npm run poll` does the
# same thing without editing this file.
# BOT_MODE=polling

# Port the health-check server listens on. Hosts set this themselves.
PORT=3000

# Interface the health server binds to. Leave it alone on a cloud host — they
# route in from outside. On a VPS that already runs other apps, 127.0.0.1 keeps
# it off the public internet.
HOST=0.0.0.0

# ---------------------------------------------------------------
#  Behaviour switches (all default to true)
# ---------------------------------------------------------------

# Accept "request to join" invite links automatically. Keep this on:
# approving is what earns the bot permission to DM the new member.
AUTO_APPROVE_JOIN_REQUESTS=true

# Post the welcome message in the group itself.
WELCOME_IN_GROUP=true

# Also send the welcome as a private message when Telegram allows it.
WELCOME_IN_DM=true

# Telegram signs webhook calls with this. Left empty it is derived from
# BOT_TOKEN, which is fine.
# WEBHOOK_SECRET=
